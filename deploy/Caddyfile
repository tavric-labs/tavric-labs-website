{
    admin off
    auto_https off
}

:8080 {
    root * /srv/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
    @assets path /assets/* /styles.css /app.js
    header @assets Cache-Control "public, max-age=3600"
    file_server
}
